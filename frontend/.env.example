# Persona AI Unified Configuration (Frontend + API Routes)

# Speech-to-Text & Text-to-Speech (Gnani AI)
GNANI_API_KEY="your_gnani_api_key_here"

# LLM Provider (Google Gemini)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash-lite"
MAX_REPLY_TOKENS=120

# Session & Security
SESSION_SECRET="replace_with_a_secure_random_string_at_least_32_characters_long"
SESSION_TTL_SECONDS=7200
ALLOWED_ORIGINS="http://localhost:3001,https://persona-ai-theta.vercel.app"

# Vector Database (Supabase pgvector - optional for local dev, required for custom RAG)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Rate Limiting & TTS Configuration
LIMIT_SESSION_TURNS_HOUR=30
LIMIT_IP_TURNS_MIN=15
MAX_TTS_CHARS=300
TTS_FORMAT="raw"

# Optional external backend override (leave unset for unified all-in-one deployment)
BACKEND_URL=""
NEXT_PUBLIC_BACKEND_URL=""
